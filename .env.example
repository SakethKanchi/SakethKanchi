# Portfolio has no env secrets in v1 (mailto link only, no Resend, no DB).
# This file exists so `dotenv` tooling knows where real values would go in v2.

# Examples (not used in v1):
# GITHUB_TOKEN=ghp_xxx  # optional: used by `scripts/sync-oss.ts` to avoid rate limits
# NEXT_PUBLIC_SITE_URL=https://example.vercel.app  # set in Vercel project env for canonical URL